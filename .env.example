APP_NAME="Threadwell"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/threadwell/public

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=threadwell
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Threadwell"

STORE_EMAIL=support@example.com
STORE_PHONE="+91 00000 00000"
STORE_ADDRESS="Your business address, India"
STORE_FREE_SHIPPING_OVER=999
STORE_SHIPPING_FEE=80
STORE_COD_FEE=50
STORE_PREPAID_DISCOUNT=10

# Leave empty in local dev to use the built-in test payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used by `php database/seed.php` for the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
